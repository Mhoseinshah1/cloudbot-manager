# CloudBot Manager — infrastructure and bootstrap configuration.
#
# This file lists only variables the current phase actually implements.
# Business values that change during normal operation (pricing thresholds,
# grace periods, kill switches) belong in database-backed settings, not here.
#
# Never commit a real .env. APP_KEY is generated during install and must be
# preserved across updates: rotating it makes existing encrypted data
# unreadable.

APP_NAME="CloudBot Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_BIND_IP=127.0.0.1
APP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cloudbot
DB_USERNAME=cloudbot
# No default. The installer generates or prompts for this; a shipped default
# would become a known production credential.
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# One logical database per concern. `cache:clear` issues FLUSHDB against the
# cache database only, so queues, bot state and locks must not share it.
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_STATE_DB=2
REDIS_LOCK_DB=3

CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=redis

# How long one provider operation may take, and how long the coordination lock
# covering it is held. Infrastructure, not business policy: a slower network
# needs a longer timeout, and the switch that decides whether provisioning may
# happen at all is a database setting instead.
#
# The lock must outlast twice the timeout, or it can expire while the call it
# covers is still running and a second worker will believe it is alone.
PROVIDER_OPERATION_TIMEOUT_SECONDS=120
PROVISIONING_LOCK_TTL_SECONDS=300

# The bot's own credentials. Neither has a default and neither may be given
# one: the token is the whole authority to act as this business in Telegram,
# and the secret is the only thing separating a real delivery from anyone who
# finds the webhook URL. Both are absent from every log and exception.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Where Telegram delivers. Must be https: the secret travels on every request.
TELEGRAM_WEBHOOK_URL=

# How long a half-finished conversation is remembered, in seconds. Runtime
# configuration rather than business policy: it decides how long a customer may
# pause mid-flow, not what anything costs.
TELEGRAM_STATE_TTL_SECONDS=1800

# Where operational alerts go: a numeric Telegram chat or channel id. Left
# empty, alerts are recorded as undeliverable rather than sent somewhere
# plausible — an operator's incidents must not quietly land in a chat nobody
# reads.
TELEGRAM_ADMIN_CHAT_ID=

# How long a revealed root password stays in the customer's chat before the bot
# tries to delete the message. Best effort only: Telegram may refuse, and the
# customer may already have read or forwarded it, so nothing about the system's
# security depends on the deletion succeeding.
ROOT_PASSWORD_VISIBLE_SECONDS=60

# How long a server action may hold its coordination lock. Must comfortably
# exceed a provider call, for the same reason the provisioning lock must.
# How many times an order may ask a provider for a fresh root password after
# its create-time credential was lost before delivery. Its own bound, never the
# VPS create budget.
CREDENTIAL_RECOVERY_MAX_ATTEMPTS=3

# How long one recovery execution waits for an asynchronous password reset.
CREDENTIAL_RECOVERY_POLL_SECONDS=10

SERVER_ACTION_LOCK_TTL_SECONDS=300

# How long a server action waits after a provider refuses it in a way that is
# safe to repeat — a rate limit, a short outage, a transient error. Durable, on
# the action row, so a job queued before the refusal honours it too.
SERVER_ACTION_RETRY_AFTER_SECONDS=120

# How long an operational alert waits when no admin destination is configured.
# Configuration absence is not a delivery failure: the alert is deferred rather
# than discarded, and does not consume its retry budget while it waits.
OUTBOX_ADMIN_DEFER_SECONDS=1800
