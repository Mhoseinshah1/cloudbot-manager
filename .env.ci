# Continuous integration only. Contains no secrets: these values address
# throwaway service containers that exist for the length of one CI job.
# APP_KEY is generated at runtime by the workflow, never committed.

APP_NAME="CloudBot Manager"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_BIND_IP=127.0.0.1
APP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cloudbot_test
DB_USERNAME=cloudbot
DB_PASSWORD=ci_not_a_secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_STATE_DB=2
REDIS_LOCK_DB=3

CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=redis
